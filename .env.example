# Bundled with the app via pubspec.yaml — replace the placeholder locally.
# Do not commit real API keys.

# Gemini API key (client-side until Node API proxy is live)
GEMINI_API_KEY=your_gemini_api_key_here

# Node API base URL (leave empty until backend is deployed)
# Example: http://localhost:3000 or https://api.yourdomain.com
API_BASE_URL=
